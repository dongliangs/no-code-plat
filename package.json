{
  "name": "lowcode-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint:es": "eslint src/**/*.{vue,js,ts}",
    "lint:fix": "eslint src/**/*.{vue,js,ts} --fix && stylelint src/**/*.vue --fix",
    "lint:style": "stylelint src/**/*.vue",
    "spellcheck": "cspell lint --dot --gitignore --color --cache src/**/*.{ts,js,vue,md,json,yaml,yml}",
    "prepare": "husky",
    "commit": "git-cz",
    "test": "vitest"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix",
    "*.vue": "stylelint --fix"
  },
  "dependencies": {
    "@glideapps/glide-data-grid": "6.0.3",
    "@icon-park/vue-next": "1.4.2",
    "@tiptap/core": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "@vue-flow/additional-components": "1.3.3",
    "@vue-flow/core": "1.48.2",
    "copy-text-to-clipboard": "3.2.2",
    "d3": "7.9.0",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "echarts": "6.1.0",
    "lucide-vue-next": "^1.0.0",
    "nanoid": "6.0.2",
    "pinia": "^4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smooth-dnd": "0.12.1",
    "veaury": "2.6.3",
    "vee-validate": "4.15.1",
    "vue": "^3.5.42",
    "vue-echarts": "8.3.2",
    "vue-json-pretty": "2.6.0",
    "vue-router": "4.4.0",
    "zrender": "6.1.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.3",
    "@cspell/dict-lorem-ipsum": "4.0.5",
    "@eslint/js": "10.0.1",
    "@types/d3": "7.4.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "commitizen": "4.3.0",
    "commitlint": "21.2.3",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "cspell": "10.4.0",
    "cz-git": "1.14.0",
    "eslint": "10.12.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.11.1",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "rollup-plugin-visualizer": "7.1.1",
    "stylelint": "17.16.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "^8.3.0",
    "vitest": "5.0.5",
    "vue-tsc": "^3.3.11"
  }
}
